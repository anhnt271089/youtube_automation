# YouTube API
YOUTUBE_API_KEY=your_youtube_api_key_here

# Google Services (using OAuth2 instead of Service Account)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
GOOGLE_ACCESS_TOKEN=your_google_oauth_access_token
GOOGLE_REFRESH_TOKEN=your_google_oauth_refresh_token

# Google Sheets & Drive Configuration
GOOGLE_MASTER_SHEET_ID=your_master_spreadsheet_id
GOOGLE_TEMPLATE_WORKBOOK_ID=your_template_workbook_id_for_video_details
GOOGLE_VIDEOS_ROOT_FOLDER_ID=your_main_drive_folder_id

# Notion
NOTION_TOKEN=your_notion_integration_token
NOTION_DATABASE_ID=your_notion_database_id

# OpenAI
OPENAI_API_KEY=your_openai_api_key

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key

# Leonardo AI (Cost-effective image generation - 85% cheaper than DALL-E)
LEONARDO_API_KEY=your_leonardo_ai_api_key
LEONARDO_DEFAULT_MODEL=leonardo-anime
LEONARDO_PRESET_STYLE=
LEONARDO_ENABLE_ALCHEMY=true
LEONARDO_CREDITS_PER_GENERATION=7
LEONARDO_MAX_RETRIES=3
LEONARDO_REQUEST_TIMEOUT=60000

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
# Toggle for all Telegram notifications (true/false)
# Set to false to disable all Telegram messages during development/testing
TELEGRAM_NOTIFICATIONS_ENABLED=true
# Network resilience settings for Telegram API
# Increased timeout for better network reliability (60 seconds)
TELEGRAM_REQUEST_TIMEOUT=60000
# More retries for network timeout issues (minimum 5 for reliability)
TELEGRAM_MAX_RETRIES=5
# Base retry delay with adaptive scaling for timeouts
TELEGRAM_RETRY_DELAY=1000

# Digital Ocean has been replaced with Google Drive for storage
# All image assets are now stored in Google Drive with shareable links

# Application Settings
NODE_ENV=development
LOG_LEVEL=info
CONCURRENT_WORKERS=4

# Image Generation Settings
# Enable/disable image generation completely (default: false to save costs)
ENABLE_IMAGE_GENERATION=false
# Enable/disable script breakdown into individual sentences (default: false)
ENABLE_SCRIPT_BREAKDOWN=false
# Limit number of images generated per video (0 = no limit)
# Set to 5 for testing to save costs and speed up workflow
IMAGE_GENERATION_LIMIT=5

# YouTube Video Format Images (16:9 aspect ratio)
IMAGE_ASPECT_RATIO=16:9
IMAGE_WIDTH=1920
IMAGE_HEIGHT=1080

# Image Generation Settings (Leonardo AI Only)
# Leonardo AI models: leonardo-anime, leonardo-phoenix, leonardo-vision-xl (~$0.002/image)
# 95.5% cheaper than DALL-E with equivalent quality
IMAGE_MODEL=leonardo-anime
ENHANCE_PROMPTS_WITH_CLAUDE_SONNET=true
COST_TRACKING_ENABLED=true
MAX_IMAGE_COST_PER_VIDEO=1.50

# Auto-approval Settings
# Set to true for testing to skip manual approval step
AUTO_APPROVE_SCRIPTS=false

# Script Length Control
# Maximum number of sentences in generated scripts to control video length
# Typical video lengths: 45-60 sentences for ~3-5 min videos, 60-80 for ~5-7 min videos
# Set to 0 for no limit (not recommended for consistency)
MAX_SCRIPT_SENTENCES=60

# Script Breakdown Options
# Google Sheets is now the primary method for script breakdowns
# Notion is used as fallback if Google Sheets fails
# Make sure Google Sheets API is enabled in Google Cloud Console
# Your main folder must be shared with the service account
GOOGLE_SHEETS_PRIMARY=true

# Interactive Content Generation Settings
# Enable interactive mode where Claude Code generates content instead of API
USE_INTERACTIVE_GENERATION=false
# Comma-separated list of content types for interactive generation
# Options: script,thumbnails,description,title,all
INTERACTIVE_CONTENT_TYPES=script,thumbnails
# Fallback to API if interactive generation fails or times out
FALLBACK_TO_API=true
# Timeout for waiting for interactive generation (milliseconds)
INTERACTIVE_GENERATION_TIMEOUT=3600000
# How long to keep completed queue items (milliseconds) 
QUEUE_CLEANUP_INTERVAL=604800000
# Enable priority-based queue processing
ENABLE_QUEUE_PRIORITIZATION=true

# Transcript Fallback Configuration
# Enable comprehensive fallback methods when YouTube transcripts are not available
ENABLE_TRANSCRIPT_FALLBACKS=true

# Whisper API fallback (requires OpenAI API key, costs money per minute)
# Only enable if you need high-quality transcripts for videos without captions
ENABLE_WHISPER_FALLBACK=false
MAX_AUDIO_DURATION_MINUTES=15

# Video description as transcript fallback (free, always recommended)
ENABLE_DESCRIPTION_FALLBACK=true

# Comments analysis fallback (uses YouTube API quota, moderate quality)
ENABLE_COMMENTS_ANALYSIS=false

# Fallback methods priority (comma-separated)
# Options: alternative-libs, whisper, description, comments
# Processed in order until one succeeds
TRANSCRIPT_FALLBACK_METHODS=alternative-libs,description,comments