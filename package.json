{
  "name": "youtube-automation",
  "version": "1.0.0",
  "description": "YouTube content automation workflow",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test-youtube": "node scripts/development/test-youtube-metadata.js",
    "test-youtube-basic": "node scripts/development/test-youtube-basic.js",
    "test-transcript-fallbacks": "node scripts/development/test-transcript-fallbacks.js",
    "health-check": "node scripts/maintenance/health-check.js",
    "test-sheets": "node scripts/maintenance/health-check.js sheets",
    "setup-google": "node scripts/setup/setup-google-oauth.js",
    "create-google-sheets": "node scripts/setup/create-google-sheets-structure.js",
    "update-sheet-headers": "node scripts/setup/update-master-sheet-headers.js",
    "test-google": "node scripts/development/test-google-integration.js",
    "test-google-health": "node scripts/development/test-google-integration.js --health",
    "test-sheet-headers": "node tests/integration/test-google-sheets-headers.js",
    "refresh-google-tokens": "node scripts/setup/setup-google-oauth.js --refresh",
    "generate-content": "node tools/generate-content.js",
    "check-queue": "node tools/check-generation-queue.js",
    "queue-status": "node tools/check-generation-queue.js",
    "test-interactive": "node tools/test-interactive-content-system.js",
    "download-pexels-assets": "node tools/download-pexels-assets.js",
    "test-pexels": "node tools/download-pexels-assets.js --health-check",
    "start-asset-scheduler": "node tools/start-asset-scheduler.js start",
    "stop-asset-scheduler": "node tools/start-asset-scheduler.js stop",
    "asset-scheduler-status": "node tools/start-asset-scheduler.js status",
    "asset-scheduler-trigger": "node tools/start-asset-scheduler.js trigger",
    "asset-scheduler-health": "node tools/start-asset-scheduler.js health",
    "asset-scheduler-stats": "node tools/start-asset-scheduler.js stats",
    "asset-scheduler-monitor": "node tools/start-asset-scheduler.js monitor",
    "test-asset-scheduler": "node tools/test-asset-scheduler-integration.js run",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:delete": "pm2 delete ecosystem.config.cjs",
    "pm2:logs": "pm2 logs",
    "pm2:monit": "pm2 monit",
    "pm2:status": "pm2 status"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.3",
    "axios": "^1.7.2",
    "commander": "^14.0.0",
    "dotenv": "^16.4.5",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.2",
    "googleapis": "^128.0.0",
    "node-cron": "^3.0.3",
    "node-telegram-bot-api": "^0.66.0",
    "open": "^9.1.0",
    "openai": "^4.52.7",
    "sharp": "^0.33.4",
    "winston": "^3.13.0",
    "youtube-captions-scraper": "^2.0.3",
    "youtube-transcript": "^1.2.1",
    "youtube-transcript-api": "^3.0.6",
    "ytdl-core": "^4.11.5"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.10",
    "@types/node-cron": "^3.0.11",
    "eslint": "^9.6.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "typescript": "^5.5.3"
  },
  "keywords": [
    "youtube",
    "automation",
    "ai",
    "content",
    "google-sheets",
    "google-drive",
    "telegram"
  ],
  "author": "Ryan Nguyen",
  "license": "MIT"
}
